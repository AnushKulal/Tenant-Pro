# -----------------------------------------------------------------------------
# TenantPro Mobile — environment config
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the value for your situation.
# Expo automatically loads variables prefixed with EXPO_PUBLIC_ into the app.
# Restart `expo start` after changing this file.
# -----------------------------------------------------------------------------

# WHERE THE APP FINDS THE BACKEND API.
#
# Local testing (phone + laptop on the SAME WiFi):
#   Use your laptop's IPv4 address (NOT "localhost" — the phone can't see that).
#   Find it with:  Windows -> ipconfig   |   Mac/Linux -> ifconfig  or  ip a
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000

# Hosted / downloadable-app build (backend is on the internet):
#   EXPO_PUBLIC_API_URL=https://your-backend-host.com


# -----------------------------------------------------------------------------
# THE MAP
# -----------------------------------------------------------------------------
# The map DATA is OpenStreetMap, which is free and open. The tile IMAGES have to
# be served by somebody, and that is a choice with terms attached: the OSM
# Foundation's own servers (tile.openstreetmap.org) explicitly do NOT allow
# distributed apps to pull from them. Leaving these blank falls back to those
# servers, which is fine while developing and not fine once the app is shipped.
#
# Pick one provider below, sign up (free, no card), paste your key in, done.
# Nothing else in the app changes — the URL just has to contain {z}, {x} and {y}.
#
# ── MapTiler — recommended. 100,000 tile loads/month free. ────────────────────
#   Sign up: https://cloud.maptiler.com/ -> Account -> Keys
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
#
# ── Geoapify — 3,000 requests/day free. ───────────────────────────────────────
#   Sign up: https://myprojects.geoapify.com/
# EXPO_PUBLIC_MAP_TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_URL_DARK=https://maps.geoapify.com/v1/tile/dark-matter/{z}/{x}/{y}.png?apiKey=YOUR_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© Geoapify © OpenStreetMap contributors
#
# ── Stadia Maps — free tier; needs the app's bundle id allowlisted. ───────────
#   Sign up: https://client.stadiamaps.com/
# EXPO_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_URL_DARK=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png?api_key=YOUR_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=© Stadia Maps © OpenStreetMap contributors
#
# The DARK one is optional — without it the light map is used in both themes,
# which looks plain rather than broken. The attribution line is a licence
# condition for whichever provider you choose, so copy the one they ask for.
