{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lintVitalAnalyzeRelease -x lintVitalRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tenantpro-backend.onrender.com",
        "EXPO_PUBLIC_MAP_TILE_URL": "$EXPO_PUBLIC_MAP_TILE_URL",
        "EXPO_PUBLIC_MAP_TILE_URL_DARK": "$EXPO_PUBLIC_MAP_TILE_URL_DARK",
        "EXPO_PUBLIC_MAP_ATTRIBUTION": "$EXPO_PUBLIC_MAP_ATTRIBUTION"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tenantpro-backend.onrender.com",
        "EXPO_PUBLIC_MAP_TILE_URL": "$EXPO_PUBLIC_MAP_TILE_URL",
        "EXPO_PUBLIC_MAP_TILE_URL_DARK": "$EXPO_PUBLIC_MAP_TILE_URL_DARK",
        "EXPO_PUBLIC_MAP_ATTRIBUTION": "$EXPO_PUBLIC_MAP_ATTRIBUTION"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
