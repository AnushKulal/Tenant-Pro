# -----------------------------------------------------------------------------
# TenantPro Backend — environment variables
# -----------------------------------------------------------------------------
# Copy this file to ".env" for local development, and set the SAME keys in your
# host's dashboard (Render / Railway) for production. NEVER commit the real .env.
# -----------------------------------------------------------------------------

# --- Server ---
PORT=5000
# Public URL of THIS backend once deployed (used to build image/QR links in emails).
# Local:      http://localhost:5000
# Production: https://your-app.onrender.com
BASE_URL=http://localhost:5000

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tenantpro_db
# Set to "true" for a cloud MySQL (Aiven / PlanetScale / Railway). Leave off locally.
DB_SSL=false
# Optional: paste the provider's CA certificate for strict TLS verification.
# Not needed for Aiven — leaving it blank uses an encrypted connection that works
# with Aiven's default certificate. Tables are auto-created on first boot.
# DB_CA_CERT=

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_this_to_a_long_random_secret

# --- Image uploads (Cloudinary) — recommended for hosted/production ---
# If set, uploaded images go to Cloudinary so they survive redeploys on hosts
# with ephemeral disks (like Render's free tier). Leave blank for local disk.
# Easiest: paste the single CLOUDINARY_URL from your Cloudinary dashboard.
CLOUDINARY_URL=
# ...or use the three separate values instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- CORS (optional) ---
# Comma-separated allowlist of browser origins. Leave blank to allow all
# (fine for the mobile app, which doesn't send an Origin header).
CORS_ORIGIN=

# --- Email: HTTPS API (PREFERRED — set ONE of these keys) -------------------
#
# Why not SMTP: many hosts block outbound SMTP ports. Render's FREE web services
# block 25, 465 and 587 outright, so a Gmail/SMTP setup there fails with a
# connection timeout no matter how correct the password is. HTTPS is never blocked.
#
# Whichever key is set wins over the SMTP settings below. To move between providers
# later, set the new key (and MAIL_PROVIDER while both are present) — no code change.
#
#   brevo     300 emails/day free. The only one here that lets you verify a single
#             SENDER ADDRESS instead of requiring a domain you own. Start here.
#   resend    3,000/month free. Needs a verified domain.
#   sendgrid  100/day free. Needs a verified domain.
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Pin the provider when more than one key is present (brevo | resend | sendgrid).
# Only needed mid-migration; leave blank to use whichever key is set.
MAIL_PROVIDER=

# The FROM address. On an HTTPS provider this MUST be an address you have verified
# with that provider, or it refuses the send. Falls back to SMTP_USER/EMAIL_USER.
MAIL_FROM=
MAIL_FROM_NAME=TenantPro

# --- Email: SMTP fallback (only if your host allows outbound SMTP) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Email: Gmail fallback (only if your host allows outbound SMTP) ----------
# EMAIL_PASS must be a 16-character App Password, not the account password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- SMS & WhatsApp (Twilio) — optional; runs in mock mode if left blank ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
